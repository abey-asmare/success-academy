// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chapter {
  id          String  @id @default(uuid())
  title       String
  description String?
  videoUrl    String?
  position    Int
  isPublished Boolean @default(false)
  isFree      Boolean @default(false)

  muxData MuxData?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userProgress UserProgress[]

  exams Exam[] @relation("ExamChapter")

  categoryId String?
  category   ChapterCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChapterCategory {
  id       String    @id @default(uuid())
  name     String
  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Course {
  id          String  @id @default(uuid())
  userId      String
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  attachments Attachment[]
  chapters    Chapter[]
  purchases   Purchase[]

  exams Exam[] @relation("ExamCourse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String
  type String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id      String   @id @default(uuid())
  name    String
  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MuxData {
  id         String  @id @default(uuid())
  assetId    String
  playbackId String?

  chapterId String  @unique
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id     String @id @default(uuid())
  userId String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
}

model Purchase {
  id     String @id @default(uuid())
  userId String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  imageUrl String
  approved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Exam {
  id          String     @id @default(uuid())
  name        String
  description String?
  questions   Question[] @relation("ExamQuestion")

  // exam can be attached to the chapter, to test the student knowledge for any desired chapter
  chapterId String?
  chapter   Chapter? @relation("ExamChapter", fields: [chapterId], references: [id], onDelete: Cascade)

  // exam can be attached to the  course, i.e simulation
  courseId     String?
  course       Course?  @relation("ExamCourse", fields: [courseId], references: [id], onDelete: Cascade)
  isSimulation Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Question {
  id       String   @id @default(uuid())
  question String
  imageUrl String?
  answers  Answer[]

  examId String
  exam   Exam   @relation("ExamQuestion", fields: [examId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Answer {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Stream {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
}

enum Referrer {
  Google
  Telegram
  Instagram
  Tiktok
  Youtube
  Friend
  Other
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  firstName    String
  lastName     String
  phone_number String
  stream       Stream    @default(NATURAL_SCIENCE)
  university   String
  referrer     Referrer? @default(Telegram)
}
